{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genesisxrp.xyz/schemas/agent-genome-v2.schema.json",
  "title": "Genesis Slot Genome v2 \u2014 permanent traits across NFT generations",
  "description": "One of exactly 1111 canonical fixed genome slots. This is distinct from the per-generation NFT ID and persona; replacement mints MUST retain identical values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "slot_id",
    "archetype",
    "stats",
    "traits",
    "visual_traits",
    "genome_hash"
  ],
  "properties": {
    "version": {
      "const": "slot-genome-v2"
    },
    "slot_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1111
    },
    "archetype": {
      "enum": [
        "prophet",
        "seeker",
        "guardian",
        "messenger",
        "architect",
        "archivist"
      ]
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curiosity",
        "reasoning",
        "sociability",
        "caution",
        "creativity",
        "persistence"
      ],
      "properties": {
        "curiosity": {
          "$ref": "#/$defs/score"
        },
        "reasoning": {
          "$ref": "#/$defs/score"
        },
        "sociability": {
          "$ref": "#/$defs/score"
        },
        "caution": {
          "$ref": "#/$defs/score"
        },
        "creativity": {
          "$ref": "#/$defs/score"
        },
        "persistence": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true,
      "maxItems": 24
    },
    "visual_traits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 32
    },
    "genome_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash of canonical slot-static fields, excluding hash itself, NFTokenID, generation and persona."
    }
  },
  "$defs": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
